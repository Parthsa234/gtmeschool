{
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/vsl",
      "destination": "https://gtme-individual.vercel.app/vsl"
    },
    {
      "source": "/apply/:path*",
      "destination": "https://gtme-individual.vercel.app/apply/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://gtme-individual.vercel.app/api/:path*"
    },
    {
      "source": "/assets/css/:path*",
      "destination": "https://gtme-individual.vercel.app/assets/css/:path*"
    },
    {
      "source": "/assets/js/:path*",
      "destination": "https://gtme-individual.vercel.app/assets/js/:path*"
    },
    {
      "source": "/assets/docs/:path*",
      "destination": "https://gtme-individual.vercel.app/assets/docs/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/corporate-vsl",
      "destination": "/",
      "permanent": false
    }
  ]
}
